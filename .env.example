# R-COREX Bitcoin Mainnet System
# Environment Configuration Example
# Copy this file to .env and configure for your environment

# Bitcoin Core Configuration
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=change_this_password
BITCOIN_NETWORK=mainnet

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bitcoin_mainnet
POSTGRES_USER=bitcoin
POSTGRES_PASSWORD=change_this_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Neo4j Configuration (Optional)
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_password

# Security
JWT_SECRET=change_this_secret_key_to_random_string
API_KEY=change_this_api_key

# Monitoring
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development
DEBUG=false
TEST_MODE=false
